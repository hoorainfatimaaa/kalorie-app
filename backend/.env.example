# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Database -------------------------------------------------------
# PostgreSQL connection string. The pgvector extension must be enabled
# on this database (see scripts/setup_memory_embeddings.py).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Security -------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string

# --- OpenAI ---------------------------------------------------------
OPENAI_API_KEY=sk-...

# --- Email (password reset) -----------------------------------------
# Any SMTP provider works. For Gmail, SMTP_PASSWORD must be a 16-character
# App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@example.com
SMTP_FROM_NAME=Kalorie

# Base URL used to build the password-reset link sent by email.
# Use http://localhost:5173 for local development.
FRONTEND_URL=http://localhost:5173

# --- Optional tuning (defaults shown) -------------------------------
# SHORT_TERM_HISTORY_LIMIT=10
# LONG_TERM_MEMORY_LIMIT=20
# MEMORY_SIMILARITY_THRESHOLD=0.25
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MAIN_REASONING_EFFORT=low
# TRANSCRIBE_LANGUAGE=en
# RESET_TOKEN_EXPIRY_MINUTES=30
# RESET_REQUEST_COOLDOWN_SECONDS=60

# Development only: prints password-reset links to the server log so the
# flow can be tested without a working SMTP configuration. Leave off in
# production.
# LOG_RESET_LINKS=false
